# Copy to .env and fill in. .env is gitignored; never commit real keys.
ANTHROPIC_API_KEY=
APIFY_TOKEN=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
CARTESIA_API_KEY=

# Where things run. The coordinator must be able to reach AGENTS_PUBLIC_URL (callbacks).
COORDINATOR_URL=http://localhost:8000
AGENTS_PUBLIC_URL=http://localhost:8001

# The event. EVENT_AREA is the coarse area every agent checks in with; matching only groups the same area.
EVENT_NAME=Cal Hacks 13
EVENT_LOCATION=Palace of Fine Arts
EVENT_CITY=San Francisco
EVENT_AREA=Palace of Fine Arts
EVENT_TZ=America/Los_Angeles

# Optional
# AGENT_MODEL=claude-opus-5-5
# AGENTS_WITH_CLAUDE=1        # 0 = rules and fallback rounds only (rehearsals)
# STAND_IN_AUTO_ACCEPT=1      # stand-in agents (personal context, no real person) accept on their own
# AGENTS_DB=agents.db
# MOSS_INDEX=agent-memory     # use a fresh name for the demo
